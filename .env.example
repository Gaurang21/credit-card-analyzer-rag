# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chat backend selection: "ollama" (default) or "groq".
# Embeddings always go through Ollama (Groq has no embeddings endpoint).
AI_PROVIDER=ollama

# Ollama on Oracle ARM VM (HTTPS via Caddy + bearer token)
OLLAMA_BASE_URL=https://your-host.duckdns.org
OLLAMA_API_TOKEN=
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Groq (hosted, OpenAI-compatible)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode — when set to "1", Supabase + Ollama are replaced with in-memory
# fakes. Lets you click around the full app without provisioning any backend.
# Use for Playwright, public demo deploys, and offline development.
NEXT_PUBLIC_DEMO_MODE=
